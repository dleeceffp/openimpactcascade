# OIC shared module credentials
# Copy this file to .env and fill in your keys

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT
OPENAI_API_KEY=sk-...

# Google Gemini (choose ONE auth method):
# Method 1: AI Studio API key (AQ.Ab8... or AIza...)
GEMINI_API_KEY=AQ.Ab8...
# Alternative name for the same key:
# GOOGLE_API_KEY=AQ.Ab8...

# Method 2: Vertex AI / Application Default Credentials (for GCP environments)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Default provider and weight for oic_llm
# OIC_LLM_PROVIDER=anthropic
# OIC_LLM_WEIGHT=heavy

# Optional: Path to config file
# OIC_LLM_CONFIG=./oic_llm.toml

# =============================================================================
# oic_search — web search / grounding module
# =============================================================================

# Provider selection (default: google_cse)
# OIC_SEARCH_PROVIDER=google_cse
# OIC_SEARCH_PROFILE=default

# --- Google Programmable Search Engine ---
# The same key used for Gemini CAN work here if Custom Search API is enabled
# on the same GCP project, but a dedicated key with minimal scope is preferred.
GOOGLE_SEARCH_API_KEY=AIza...
# One engine (cx) ID per OIC source profile — create at https://programmablesearchengine.google.com
# Site-Restricted profiles (<=10 domains) have no daily query limit.
OIC_SEARCH_CSE_DEFAULT=<cx-for-default-22-site-engine>
OIC_SEARCH_CSE_INCIDENT=<cx-for-incident-engine>      # cisa.gov, ic3.gov, verizon, enisa...
OIC_SEARCH_CSE_FRAMEWORK=<cx-for-framework-engine>    # attack.mitre.org, nvd.nist.gov...
OIC_SEARCH_CSE_THREATINTEL=<cx-for-threatintel-engine> # mandiant, crowdstrike, microsoft...
OIC_SEARCH_CSE_ICS=<cx-for-ics-engine>               # dragos, claroty, nerc, isa...
# Backward-compat fallback (used if no profile-specific cx is set):
# GOOGLE_SEARCH_CSE_ID=<legacy-single-engine-cx>

# --- Brave Search (non-Google alternative) ---
# BRAVE_SEARCH_API_KEY=BSA...

# --- Tavily (optional, purpose-built for LLM grounding) ---
# TAVILY_API_KEY=tvly-...

# Cache settings (optional)
# OIC_SEARCH_CACHE_DIR=~/.cache/oic/search
# OIC_SEARCH_CACHE_TTL=86400

# Optional: Path to config file
# OIC_SEARCH_CONFIG=./oic_search.toml