# OIC shared module credentials
# Copy this file to .env and fill in your keys

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT
OPENAI_API_KEY=sk-...

# Google Gemini (choose ONE auth method):
# Method 1: AI Studio API key (AQ.Ab8... or AIza...)
GEMINI_API_KEY=AQ.Ab8...
# Alternative name for the same key:
# GOOGLE_API_KEY=AQ.Ab8...

# Method 2: Vertex AI / Application Default Credentials (for GCP environments)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Default provider and weight for oic_llm
# OIC_LLM_PROVIDER=anthropic
# OIC_LLM_WEIGHT=heavy

# Optional: Path to config file
# OIC_LLM_CONFIG=./oic_llm.toml

# =============================================================================
# oic_search — web search / grounding module
# =============================================================================

# Active provider — set to brave or tavily (see sections below).
# google_cse is NOT available to new GCP accounts (closed to new customers,
# deprecated Jan 2027).  Leave google_cse commented out.
OIC_SEARCH_PROVIDER=tavily
# OIC_SEARCH_PROVIDER=brave
# OIC_SEARCH_PROFILE=default

# --- Tavily (recommended — purpose-built for LLM grounding) ---
# Returns pre-extracted content rather than raw snippets; better for LLM prompts.
# Free tier: 1,000 queries/month.  Sign up: https://tavily.com
# No engine IDs needed — domain scoping handled automatically per OIC profile.
# Recency filtering: pass time_range="month" (or "day"/"week"/"year") via **opts.
TAVILY_API_KEY=tvly-...

# --- Brave Search (lower cost, raw snippet format) ---
# Free tier: 2,000 queries/month.  Sign up: https://api-dashboard.search.brave.com/
# No engine IDs needed — profile domains applied as site: operators automatically.
# Recency filtering: pass freshness="pm" (or "pd"/"pw"/"py") via **opts.
# BRAVE_SEARCH_API_KEY=BSA...

# --- Google Programmable Search Engine (NOT available to new GCP accounts) ---
# Closed to new customers as of mid-2025; deprecated for all users Jan 1, 2027.
# Retained for existing customers only — do not attempt to set up on new projects.
# GOOGLE_SEARCH_API_KEY=AIza...
# OIC_SEARCH_CSE_DEFAULT=<cx-for-default-22-site-engine>
# OIC_SEARCH_CSE_INCIDENT=<cx-for-incident-engine>
# OIC_SEARCH_CSE_FRAMEWORK=<cx-for-framework-engine>
# OIC_SEARCH_CSE_THREATINTEL=<cx-for-threatintel-engine>
# OIC_SEARCH_CSE_ICS=<cx-for-ics-engine>
# GOOGLE_SEARCH_CSE_ID=<legacy-single-engine-fallback>

# Cache settings (optional)
# OIC_SEARCH_CACHE_DIR=~/.cache/oic/search
# OIC_SEARCH_CACHE_TTL=86400

# Optional: Path to config file
# OIC_SEARCH_CONFIG=./oic_search.toml