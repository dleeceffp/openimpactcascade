# API Keys for oic_llm test harness and workbench
# Copy this file to .env and fill in your keys

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT
OPENAI_API_KEY=sk-...

# Google Gemini (choose ONE auth method):
# Method 1: AI Studio API key (AQ.Ab8... or AIza...)
GEMINI_API_KEY=AQ.Ab8...
# Alternative name for the same key:
# GOOGLE_API_KEY=AQ.Ab8...

# Method 2: Vertex AI / Application Default Credentials (for GCP environments)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Default provider and weight for oic_llm
# OIC_LLM_PROVIDER=anthropic
# OIC_LLM_WEIGHT=heavy

# Optional: Path to config file
# OIC_LLM_CONFIG=./oic_llm.toml