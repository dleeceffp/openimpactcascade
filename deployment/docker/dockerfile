# Use Python 3.11 slim image
FROM python:3.11-slim

# tested Nov 9 / 2025
# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY flask_app_chat_v21_rag_enhanced.py .
COPY ai_question_generator_with_rag_rationale.py .
COPY user_tracking.py .
COPY vertex_rag_complete.py .
COPY simulation_enhanced.py .

# Copy templates and static directories
COPY templates/ templates/
COPY static/ static/

# Create runtime directories
RUN mkdir -p generated logs/api_calls

# Set environment variables
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8080

# Run with gunicorn
CMD exec gunicorn --bind :$PORT --workers 1 --threads 8 --timeout 0 flask_app_chat_v21_rag_enhanced:app