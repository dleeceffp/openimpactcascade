# Test all the components of the docker container locally

# Need some directories for the app to run
mkdir -p static/js static/css static/images
mkdir -p templates logs generated

python -m venv venv
source venv/bin/activate
pip install -r app/requirements.txt

# IMPORTANT: Never hardcode API keys here! Export these locally or use an .env file.
# export ANTHROPIC_API_KEY="your-anthropic-key-here"
# export SECRET_KEY="your-secret-key-here"
export GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
export GCS_BUCKET_NAME="your-app-bucket-name"
export VERTEX_RAG_CORPUS="your-corpus-id"
export VERTEX_AI_LOCATION="us-central1"

# Use your ADC or a securely stored SA key
# export GOOGLE_APPLICATION_CREDENTIALS="/path/to/secure/service-account.json"

# Build the Docker image
docker build -t openimpactcascade:local .

# Run locally (test mode)
docker run -p 8080:8080 \
    -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY}" \
    -e SECRET_KEY="${SECRET_KEY}" \
    -e GOOGLE_CLOUD_PROJECT="${GOOGLE_CLOUD_PROJECT}" \
    -v ~/.config/gcloud/application_default_credentials.json:/app/service-account-key.json:ro \
    -e GOOGLE_APPLICATION_CREDENTIALS="/app/service-account-key.json" \
    openimpactcascade:local

# Test in browser
# open http://localhost:8080
