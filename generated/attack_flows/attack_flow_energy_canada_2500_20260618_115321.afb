    {
      "id": "action",
      "instance": "06083532-1316-437b-bb76-930fbfd5fda1",
      "properties": [
        [
          "name",
          "Golden Ticket Forging"
        ],
        [
          "tactic_id",
          "TA0006"
        ],
        [
          "tactic_ref",
