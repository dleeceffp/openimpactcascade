    {
      "id": "action",
      "instance": "b50441ad-1555-482f-8fc8-f89f52657062",
      "properties": [
        [
          "name",
          "Valid Account Use via Stolen Credentials"
        ],
        [
          "tactic_id",
          "TA0001"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--ffd5bcee-6e16-4dd2-8eca-7b3beedf33ca"
        ],
        [
          "technique_id",
          "T1078.002"
