        ],
        [
          "technique_ref",
          "attack-pattern--e624264c-033a-424d-9fd7-fc9c3bbdb03e"
        ],
        [
          "description",
          "Using NTLM hashes from LSASS dumps or cracked Kerberoast credentials, the attacker performs pass-the-hash to authenticate to higher-value systems — jump servers, IT management hosts, or Tier 0 workstations — without knowing cleartext passwords. This moves the attacker closer to AD Tier 0 assets."
        ],
        [
          "confidence",
          "reported"
        ],
