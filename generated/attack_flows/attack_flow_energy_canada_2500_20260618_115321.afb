    {
      "id": "action",
      "instance": "398ec7f8-dcc3-417d-bb62-bf35b0358f09",
      "properties": [
        [
          "name",
          "Internal Network and AD Enumeration"
        ],
        [
          "tactic_id",
          "TA0007"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--0b20d6d2-e6cd-4c36-b984-eed9f15f4bff"
        ],
        [
          "technique_id",
          "T1018"
        ],
        [
          "technique_ref",
          "attack-pattern--e358d692-23c0-4a31-9eb6-ecc13a8d7735"
        ],
        [
          "description",
          "The attacker uses BloodHound/SharpHound or built-in Windows tools (net, nltest, dsquery) to enumerate Active Directory objects: users, groups, GPOs, domain trusts, and privileged accounts. This maps attack paths to Domain Admin. In a ~2500-user AD environment, misconfigurations (unconstrained delegation, over-permissioned service accounts) are common targets."
        ],
        [
          "confidence",
          "reported"
        ],
        [
          "execution_start",
          null
        ],
        [
          "execution_end",
          null
        ],
