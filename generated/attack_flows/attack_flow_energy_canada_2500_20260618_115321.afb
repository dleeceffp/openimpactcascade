      "scope": "incident",
      "attack_actions": [
        {
          "id": "n1",
          "name": "Spearphishing Link to Credential Harvesting Page",
          "technique_id": "T1566.002",
          "tactic": "Initial Access",
          "description": "Attackers send targeted spearphishing emails to energy company employees (particularly IT helpdesk, OT engineers, or finance staff) containing links to a spoofed Microsoft 365 or VPN login page. The lure uses energy-sector context such as fake utility billing portals or NERC compliance notifications. Credentials are harvested via an adversary-in-the-middle proxy (e.g., Evilginx2) to bypass MFA by capturing session tokens.",
          "depends_on": [],
          "confidence": "reported"
        },
        {
          "id": "n2",
          "name": "Valid Account Use via Stolen Credentials",
          "technique_id": "T1078.002",
          "tactic": "Initial Access",
          "description": "Using harvested domain credentials and captured session tokens, the attacker authenticates to corporate VPN or Microsoft 365/Azure AD as a legitimate domain user, bypassing MFA. This provides initial network access without deploying any malware.",
          "depends_on": [
            "n1"
          ],
          "confidence": "reported"
        },
        {
          "id": "n3",
          "name": "Remote Services Access via VPN/RDP",
          "technique_id": "T1133",
          "tactic": "Initial Access",
          "description": "With valid credentials, the attacker connects to the corporate network via the organization's VPN gateway or directly via an externally exposed RDP endpoint. At ~2500 employees, VPN concentrators are a common entry path. This establishes an interactive session on an internal host.",
          "depends_on": [
            "n2"
          ],
          "confidence": "reported"
        },
        {
          "id": "n4",
          "name": "LSASS Memory Credential Dumping",
          "technique_id": "T1003.001",
          "tactic": "Credential Access",
          "description": "Once on an internal Windows host with local admin rights (or after a privilege escalation), the attacker uses tools such as Mimikatz or a custom LSASS dump technique to extract NTLM hashes and Kerberos tickets from memory. This yields credentials for additional domain accounts, including potentially privileged service accounts.",
          "depends_on": [
            "n3"
          ],
          "confidence": "reported"
        },
        {
          "id": "n5",
          "name": "Internal Network and AD Enumeration",
          "technique_id": "T1018",
          "tactic": "Discovery",
          "description": "The attacker uses BloodHound/SharpHound or built-in Windows tools (net, nltest, dsquery) to enumerate Active Directory objects: users, groups, GPOs, domain trusts, and privileged accounts. This maps attack paths to Domain Admin. In a ~2500-user AD environment, misconfigurations (unconstrained delegation, over-permissioned service accounts) are common targets.",
          "depends_on": [
            "n3"
          ],
          "confidence": "reported"
        },
        {
          "id": "n6",
          "name": "Kerberoasting — Service Account Ticket Extraction",
          "technique_id": "T1558.003",
          "tactic": "Credential Access",
          "description": "Using domain user access, the attacker requests Kerberos service tickets (TGS) for service accounts identified during AD enumeration (e.g., SQL service accounts, backup agents). Tickets are cracked offline to recover plaintext passwords. Energy sector organizations often run legacy service accounts with weak passwords and high privileges.",
          "depends_on": [
            "n5"
          ],
          "confidence": "reported"
        },
        {
          "id": "n7",
          "name": "Lateral Movement to Privileged Host via Pass-the-Hash",
          "technique_id": "T1550.002",
          "tactic": "Lateral Movement",
          "description": "Using NTLM hashes from LSASS dumps or cracked Kerberoast credentials, the attacker performs pass-the-hash to authenticate to higher-value systems — jump servers, IT management hosts, or Tier 0 workstations — without knowing cleartext passwords. This moves the attacker closer to AD Tier 0 assets.",
          "depends_on": [
            "n4",
            "n6"
