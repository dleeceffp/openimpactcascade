    {
      "id": "action",
      "instance": "c1c002ca-25d3-41e1-812c-2e8c8a034773",
      "properties": [
        [
          "name",
          "Kerberoasting — Service Account Ticket Extraction"
        ],
        [
          "tactic_id",
          "TA0006"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--2558fd61-8c75-4730-900d-122e8cdaea9e"
        ],
        [
          "technique_id",
          "T1558.003"
        ],
        [
          "technique_ref",
          "attack-pattern--f2877f7f-9a4c-4251-879f-1224e3006bee"
        ],
        [
          "description",
          "Using domain user access, the attacker requests Kerberos service tickets (TGS) for service accounts identified during AD enumeration (e.g., SQL service accounts, backup agents). Tickets are cracked offline to recover plaintext passwords. Energy sector organizations often run legacy service accounts with weak passwords and high privileges."
        ],
        [
          "confidence",
          "reported"
        ],
        [
          "execution_start",
          null
        ],
        [
          "execution_end",
          null
        ],
