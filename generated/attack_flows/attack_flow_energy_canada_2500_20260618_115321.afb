    {
      "id": "action",
      "instance": "34152f8b-fc7a-42ad-a181-34d8777d317d",
      "properties": [
        [
          "name",
          "Lateral Movement to Privileged Host via Pass-the-Hash"
        ],
        [
          "tactic_id",
          "TA0008"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--7141578b-e50b-4dcc-bfa4-08a8dd689e9e"
        ],
