    {
      "id": "action",
      "instance": "13baf487-e77e-40ae-830a-7b380ae843a3",
      "properties": [
        [
          "name",
          "DCSync Attack — Domain Credential Replication"
        ],
        [
          "tactic_id",
          "TA0006"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--2558fd61-8c75-4730-900d-122e8cdaea9e"
        ],
        [
          "technique_id",
          "T1003.006"
        ],
        [
          "technique_ref",
          "attack-pattern--f303a39a-6255-4b89-aecc-18c4d8ca7163"
        ],
        [
          "description",
          "Once a user with sufficient replication privileges (e.g., a compromised Domain Admin or account with DS-Replication-Get-Changes-All) is available, the attacker uses Mimikatz DCSync to remotely replicate all domain password hashes from the Domain Controller, including the KRBTGT hash. This is the key prerequisite for full AD takeover."
        ],
        [
          "confidence",
          "reported"
        ],
        [
          "execution_start",
          null
        ],
        [
          "execution_end",
          null
        ],
