    {
      "id": "action",
      "instance": "327842e8-5118-479b-96a1-28a9dd9776e2",
      "properties": [
        [
          "name",
          "Inhibit System Recovery — Backup and Shadow Copy Deletion"
        ],
        [
          "tactic_id",
          "TA0040"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--5569339b-94c2-49ee-afb3-2222936582c8"
        ],
        [
          "technique_id",
          "T1490"
        ],
        [
          "technique_ref",
          "attack-pattern--f5d8eed6-48a9-4cdf-a3d7-d1ffa99c3d2a"
        ],
        [
          "description",
          "Using Domain Admin rights, the attacker disables Windows Backup services, deletes VSS shadow copies across the domain via GPO or remote commands (vssadmin, wmic), and disables backup agent services. This destroys recovery options ahead of ransomware deployment, consistent with Black Basta and LockBit pre-encryption behavior observed in energy sector incidents."
        ],
        [
          "confidence",
          "reported"
        ],
