        {
          "id": "n8",
          "name": "DCSync Attack — Domain Credential Replication",
          "technique_id": "T1003.006",
          "tactic": "Credential Access",
          "description": "Once a user with sufficient replication privileges (e.g., a compromised Domain Admin or account with DS-Replication-Get-Changes-All) is available, the attacker uses Mimikatz DCSync to remotely replicate all domain password hashes from the Domain Controller, including the KRBTGT hash. This is the key prerequisite for full AD takeover.",
          "depends_on": [
