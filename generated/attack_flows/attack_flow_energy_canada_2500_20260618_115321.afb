    {
      "id": "action",
      "instance": "f5c7a235-5528-4dbf-83f3-be4721eb546c",
      "properties": [
        [
          "name",
          "Scheduled Task Persistence on Domain Controller"
        ],
        [
          "tactic_id",
          "TA0003"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--5bc1d813-693e-4823-9961-abf9af4b0e92"
        ],
        [
          "technique_id",
          "T1053.005"
        ],
        [
          "technique_ref",
          "attack-pattern--005a06c6-14bf-4118-afa0-ebcd8aebb0c9"
        ],
        [
          "description",
          "With full AD control, the attacker creates scheduled tasks on Domain Controllers to ensure persistent execution of a backdoor or C2 beacon even if credentials are rotated. This is a common pre-ransomware staging step used by criminal gangs to maintain access before detonation."
        ],
        [
          "confidence",
          "speculative"
        ],
        [
