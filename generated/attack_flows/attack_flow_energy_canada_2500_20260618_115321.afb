    {
      "id": "action",
      "instance": "1f17a1e4-ece1-43f3-8c81-c7e38e785bcd",
      "properties": [
        [
          "name",
          "Spearphishing Link to Credential Harvesting Page"
        ],
        [
          "tactic_id",
          "TA0001"
        ],
        [
          "tactic_ref",
          "x-mitre-tactic--ffd5bcee-6e16-4dd2-8eca-7b3beedf33ca"
        ],
        [
          "technique_id",
          "T1566.002"
        ],
        [
          "technique_ref",
          "attack-pattern--2b742742-28c3-4e1b-bab7-8350d6300fa7"
        ],
        [
          "description",
          "Attackers send targeted spearphishing emails to energy company employees (particularly IT helpdesk, OT engineers, or finance staff) containing links to a spoofed Microsoft 365 or VPN login page. The lure uses energy-sector context such as fake utility billing portals or NERC compliance notifications. Credentials are harvested via an adversary-in-the-middle proxy (e.g., Evilginx2) to bypass MFA by capturing session tokens."
        ],
        [
          "confidence",
          "reported"
        ],
        [
          "execution_start",
          null
        ],
        [
          "execution_end",
          null
        ],
